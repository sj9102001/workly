# ============================================================================
# Workly configuration
# ============================================================================
# Copy to `.env` and edit. Every value has a sensible default for the bundled
# docker-compose stack, so a fresh clone runs with zero edits. Override any
# section to swap in your own infrastructure — managed Postgres, cloud Kafka,
# external hosts — without touching code.
#
#   cp .env.example .env
# ============================================================================


# ----------------------------------------------------------------------------
# DATABASE  (PostgreSQL)
# ----------------------------------------------------------------------------
# Leave unset to use the docker-compose `postgres` service.
# Set these to point at ANY Postgres: AWS RDS, Cloud SQL, Neon, Supabase,
# self-hosted, etc. URL is standard JDBC.
#
# DB_URL=jdbc:postgresql://your-host:5432/your-database
# DB_USERNAME=your-username
# DB_PASSWORD=your-password
# DB_SHOW_SQL=false


# ----------------------------------------------------------------------------
# KAFKA  (event bus — used by the outbox/notification pipeline)
# ----------------------------------------------------------------------------
# KAFKA_ENABLED=false disables all Kafka wiring; the app still runs (events
# that would be published are simply not delivered). Use this for the simplest
# possible deploy with no broker.
#
# KAFKA_ENABLED=true

# Broker address. Defaults to the docker-compose `kafka` service.
# For a host process talking to the compose broker, use localhost:9092.
# For a cloud broker, use its bootstrap endpoint.
# KAFKA_BOOTSTRAP_SERVERS=your-broker:9092

# --- Kafka security (only for managed/cloud brokers) ---
# Leave ALL of these unset for a local PLAINTEXT broker. Set them to connect to
# Confluent Cloud, Amazon MSK, Aiven, Redpanda Cloud, etc.
#
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.plain.PlainLoginModule required username="<key>" password="<secret>";
# KAFKA_SSL_TRUSTSTORE_LOCATION=/path/to/truststore.jks
# KAFKA_SSL_TRUSTSTORE_PASSWORD=changeit


# ----------------------------------------------------------------------------
# FRONTEND  ->  BACKEND  connection
# ----------------------------------------------------------------------------
# API_BASE_URL is read at RUNTIME by the frontend (via its /config route), so
# the same built image can be deployed to any host without rebuilding. Set this
# to wherever your backend is reachable from the browser.
#
# API_BASE_URL=https://api.your-domain.com

# Build-time fallback (baked into the bundle at `next build`). Only needed if
# you cannot set a runtime env var on your frontend host. Used by the
# docker-compose frontend build arg below.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080


# ----------------------------------------------------------------------------
# BACKEND  —  JWT  (REQUIRED: change the secret before any real deployment)
# ----------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14


# ----------------------------------------------------------------------------
# BACKEND  —  Cookies
# ----------------------------------------------------------------------------
# Set COOKIE_SECURE=true in production (HTTPS). If frontend and backend are on
# different domains, you will likely need COOKIE_SAME_SITE=None (+ HTTPS).
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict


# ----------------------------------------------------------------------------
# BACKEND  —  Invites
# ----------------------------------------------------------------------------
INVITE_DAYS=7
